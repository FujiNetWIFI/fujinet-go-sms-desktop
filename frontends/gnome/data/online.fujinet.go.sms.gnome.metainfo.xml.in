      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-sms-desktop/main/data/screenshots/1_running_config.png</image>
    </screenshot>
    <screenshot>
      <caption>The built-in debugger's live VDP viewer</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-sms-desktop/main/data/screenshots/2_vdp_debugger.png</image>
    </screenshot>
    <screenshot>
      <caption>Preferences</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-sms-desktop/main/data/screenshots/3_preferences.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <!-- The CURRENT release templates its version from @PROJECT_VERSION@, so
         it cannot disagree with the tree; past releases are literal. The
         release job checks that this first entry is still a template. -->
    <release version="@PROJECT_VERSION@" date="2026-10-07">
      <description>
        <p>
          First release: MAME's Master System with the FujiNet Master System
          cartridge, an in-process FujiNet, six consoles, native GNOME, KDE,
          macOS and Windows frontends, both joypads on screen, hotplugged
          gamepads and a native debugger.
        </p>
      </description>
    </release>
  </releases>
</component>
